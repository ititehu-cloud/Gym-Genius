
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }
    
    function incomingDataIsOwned() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow get, create, update: if isOwner(userId);
      allow list, delete: if false;
    }
    
    match /members/{memberId} {
      allow read, delete: if isDocOwner();
      allow create: if incomingDataIsOwned();
      allow update: if isDocOwner() && incomingDataIsOwned();
    }

    match /attendance/{attendanceId} {
      allow read, delete: if isDocOwner();
      allow create: if incomingDataIsOwned();
      allow update: if isDocOwner() && incomingDataIsOwned();
    }

    match /payments/{paymentId} {
      allow read, delete: if isDocOwner();
      allow create: if incomingDataIsOwned();
      allow update: if isDocOwner() && incomingDataIsOwned();
    }

    match /plans/{planId} {
      allow read, delete: if isDocOwner();
      allow create: if incomingDataIsOwned();
      allow update: if isDocOwner() && incomingDataIsOwned();
    }

    match /notes/{noteId} {
      allow read, delete: if isDocOwner();
      allow create: if incomingDataIsOwned();
      allow update: if isDocOwner() && incomingDataIsOwned();
    }
  }
}
