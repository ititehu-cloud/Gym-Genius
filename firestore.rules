
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper to check if a user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper to check if the data belongs to the authenticated user
    function isOwner(data) {
      return isSignedIn() && data.userId == request.auth.uid;
    }

    // Rules for the User Profiles collection (where doc ID is the UID)
    match /users/{userId} {
      allow get, create, update: if isSignedIn() && request.auth.uid == userId;
      allow list, delete: if false;
    }
    
    // Explicit rules for the payments collection with validation
    match /payments/{paymentId} {
      allow read, delete: if isOwner(resource.data);
      allow update: if isOwner(resource.data) && isOwner(request.resource.data);
      allow create: if isOwner(request.resource.data) &&
        request.resource.data.memberId is string &&
        request.resource.data.amount is number &&
        request.resource.data.paymentDate is string &&
        request.resource.data.paymentMethod is string &&
        request.resource.data.paymentType is string &&
        request.resource.data.status is string &&
        request.resource.data.createdAt == request.time;
    }
    
    // Generic rules for other gym-related collections
    match /attendance/{id} {
      allow read, delete: if isOwner(resource.data);
      allow create, update: if isOwner(request.resource.data);
    }

    match /plans/{id} {
      allow read, delete: if isOwner(resource.data);
      allow create, update: if isOwner(request.resource.data);
    }

    match /members/{id} {
      allow read, delete: if isOwner(resource.data);
      allow create, update: if isOwner(request.resource.data);
    }

    match /notes/{id} {
      allow read, delete: if isOwner(resource.data);
      allow create, update: if isOwner(request.resource.data);
    }
    
    // Catch-all for any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
