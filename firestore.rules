rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper to check if a user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Explicit Ownership Rules for Gym Collections
    // Matches documents where the 'userId' field in the data matches the authenticated UID
    
    match /users/{userId} {
      allow get, create, update: if isSignedIn() && request.auth.uid == userId;
      allow list, delete: if false;
    }
    
    match /attendance/{id} {
      allow list: if isSignedIn() && request.query.limit <= 1000; // Basic query safety
      allow get, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /payments/{id} {
      allow list: if isSignedIn() && request.query.limit <= 1000;
      allow get, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /plans/{id} {
      allow list: if isSignedIn() && request.query.limit <= 1000;
      allow get, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /members/{id} {
      allow list: if isSignedIn() && request.query.limit <= 1000;
      allow get, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /notes/{id} {
      allow list: if isSignedIn() && request.query.limit <= 1000;
      allow get, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }
    
    // Catch-all denial
    match /{document=**} {
      allow read, write: if false;
    }
  }
}