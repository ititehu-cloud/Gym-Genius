
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Check if the authenticated user owns the existing document
    function isDocOwner() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }
    
    // Check if the authenticated user will own the new/updated document
    function incomingDataIsOwned() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow get, create, update: if isSignedIn() && request.auth.uid == userId;
      allow list, delete: if false;
    }
    
    match /members/{memberId} {
      allow get, list, delete: if isDocOwner();
      allow create: if incomingDataIsOwned();
      allow update: if isDocOwner() && incomingDataIsOwned();
    }

    match /attendance/{attendanceId} {
      allow get, list, delete: if isDocOwner();
      allow create: if incomingDataIsOwned();
      allow update: if isDocOwner() && incomingDataIsOwned();
    }

    match /payments/{paymentId} {
      allow get, list, delete: if isDocOwner();
      allow create: if incomingDataIsOwned();
      allow update: if isDocOwner() && incomingDataIsOwned();
    }

    match /plans/{planId} {
      allow get, list, delete: if isDocOwner();
      allow create: if incomingDataIsOwned();
      allow update: if isDocOwner() && incomingDataIsOwned();
    }

    match /notes/{noteId} {
      allow get, list, delete: if isDocOwner();
      allow create: if incomingDataIsOwned();
      allow update: if isDocOwner() && incomingDataIsOwned();
    }
  }
}
