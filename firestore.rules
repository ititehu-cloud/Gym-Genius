
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper to check if a user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Rules for the User Profiles collection
    match /users/{userId} {
      allow get, create, update: if isSignedIn() && request.auth.uid == userId;
      allow list, delete: if false;
    }
    
    // Generic ownership rule for gym data collections
    match /{collectionName}/{docId} {
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      
      // Ensure these rules only apply to our known gym collections
      // to avoid accidental shadowing of other paths.
      allow read, write: if collectionName in ['attendance', 'payments', 'plans', 'members', 'notes'] 
        ? (isSignedIn() && (
            (request.resource != null && request.resource.data.userId == request.auth.uid) ||
            (resource != null && resource.data.userId == request.auth.uid)
          ))
        : false;
    }
    
    // Catch-all for any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
