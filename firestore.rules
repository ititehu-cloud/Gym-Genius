
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper to check if a user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper to check if the data belongs to the authenticated user
    // Used for both existing data (resource.data) and incoming data (request.resource.data)
    function isOwner(data) {
      return isSignedIn() && data.userId == request.auth.uid;
    }

    // Rules for the User Profiles collection (where doc ID is the UID)
    match /users/{userId} {
      allow get, create, update: if isSignedIn() && request.auth.uid == userId;
      allow list, delete: if false;
    }
    
    // Unified rules for all gym-related collections
    // Logic: User must be signed in and the document must belong to them (via userId field)
    match /attendance/{id} {
      allow read, delete: if isOwner(resource.data);
      allow create, update: if isOwner(request.resource.data);
    }

    match /payments/{id} {
      allow read, delete: if isOwner(resource.data);
      allow create, update: if isOwner(request.resource.data);
    }

    match /plans/{id} {
      allow read, delete: if isOwner(resource.data);
      allow create, update: if isOwner(request.resource.data);
    }

    match /members/{id} {
      allow read, delete: if isOwner(resource.data);
      allow create, update: if isOwner(request.resource.data);
    }

    match /notes/{id} {
      allow read, delete: if isOwner(resource.data);
      allow create, update: if isOwner(request.resource.data);
    }
    
    // Catch-all for any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
